// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Singleton row (id always 1) holding global site info, hero copy and contact details.
model SiteSettings {
  id                Int      @id @default(1)
  name              String   @default("Avanço Ambiental")
  tagline           String   @default("Consultoria ambiental com disponibilidade, proximidade e eficiência")
  phone1            String   @default("")
  phone2            String   @default("")
  whatsapp          String   @default("")
  email             String   @default("")
  addressLine1      String   @default("")
  addressLine2      String   @default("")
  instagram         String   @default("")
  linkedin          String   @default("")
  facebook          String   @default("")
  heroEyebrow       String   @default("Conselheiro Lafaiete — MG")
  heroHeadlineWhite String   @default("Licenciamento Ambiental")
  heroHeadlineGreen String   @default("sem burocracia.")
  heroSubtext       String   @default("")
  heroImage         String   @default("/images/drone-represa-serra.jpg")
  teamImage         String   @default("/images/equipe-campo-02.jpg")
  footerLogo        String   @default("/brand/logo-white.png")
  servicesEyebrow   String   @default("Serviços")
  servicesHeadline  String   @default("Soluções ambientais completas para cada etapa do seu projeto")
  heroCtaLabel      String   @default("Solicitar diagnóstico gratuito")
  heroSecondaryCtaLabel String @default("Conhecer serviços")
  ctaEyebrow        String   @default("Solicite um diagnóstico técnico")
  ctaText           String   @default("Não espere receber uma notificação ambiental para agir. Nossa equipe está pronta para analisar seu empreendimento e indicar a melhor solução.")
  ctaButtonLabel    String   @default("Falar com um especialista")
  aboutEyebrow      String   @default("Quem somos")
  aboutHeadline     String   @default("Consultoria ambiental próxima, técnica e comprometida com resultado")
  aboutText1        String   @default("A Avanço Ambiental reúne profissionais experientes para viabilizar projetos socioambientais multidisciplinares. Para cada segmento econômico, entendemos as demandas específicas do seu negócio e construímos soluções sob medida — sempre com uma relação próxima e transparente com clientes e parceiros.")
  aboutText2        String   @default("Do estudo técnico ao acompanhamento em campo, conduzimos cada etapa com agilidade, buscando resultados rápidos e efetivos que impulsionam seu negócio com práticas ambientais sustentáveis.")
  aboutStat1Value   String   @default("4")
  aboutStat1Label   String   @default("Especialistas multidisciplinares")
  aboutStat2Value   String   @default("MG")
  aboutStat2Label   String   @default("Atendimento em todo o estado")
  aboutImage1       String   @default("/images/campo-sondagem-solo.jpg")
  aboutImage2       String   @default("/images/campo-viveiro-mudas.jpg")

  headerLogoDark    String   @default("/brand/logo-dark.png")
  headerLogoLight   String   @default("/brand/logo-white.png")
  headerCtaLabel    String   @default("Fale com especialista")

  painPointsHeadline String  @default("Enquanto você cuida do seu negócio, nós cuidamos da sua regularização ambiental.")
  painPointsLabel   String   @default("Problemas ambientais podem gerar:")
  painPointsText    String   @default("Nossa equipe acompanha todo o processo junto aos órgãos ambientais para que sua empresa continue crescendo de forma segura.")
  painPointsImage   String   @default("/images/campo-retroescavadeira.jpg")

  pillarsEyebrow    String   @default("Especialidades")
  pillarsHeadline   String   @default("Somos especialistas em soluções ambientais")

  blocksEyebrow     String   @default("Serviços de campo")
  blocksHeadline    String   @default("Investigação, execução e precisão em cada etapa")

  sectorsEyebrow    String   @default("Segmentos")
  sectorsHeadline   String   @default("Atendemos diversos segmentos")

  clientsHeadline   String   @default("Empresas e produtores que confiam na Avanço Ambiental")

  whyUsEyebrow      String   @default("Por que escolher a Avanço Ambiental?")
  whyUsHeadline     String   @default("Uma equipe técnica próxima do seu projeto, do início ao fim")
  whyUsImage        String   @default("/images/equipe-campo-01.jpg")

  processEyebrow    String   @default("Nosso método")
  processHeadline   String   @default("Método de trabalho")

  gainsHeadline     String   @default("O que nossos clientes ganham")

  galleryEyebrow    String   @default("Galeria")
  galleryHeadline   String   @default("O nosso trabalho, visto do chão e do alto")

  faqEyebrow        String   @default("Perguntas frequentes")
  faqHeadline       String   @default("Dúvidas frequentes")
  faqImage          String   @default("/images/campo-viveiro-mudas.jpg")

  teamEyebrow       String   @default("Equipe")
  teamHeadline      String   @default("Formações multidisciplinares, presentes em campo")
  teamText          String   @default("Nossa equipe reúne profissionais de diferentes formações técnicas, trabalhando juntos para viabilizar o seu projeto do início ao fim.")

  contactEyebrow    String   @default("Contato")
  contactHeadline   String   @default("Vamos avançar juntos com o seu projeto")
  contactText       String   @default("Fale com a nossa equipe e receba uma proposta sob medida para a sua demanda ambiental.")

  updatedAt         DateTime @updatedAt
}

model NavItem {
  id    String @id @default(cuid())
  label String
  href  String
  order Int    @default(0)
}

model HeroChecklistItem {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)
}

model PainPoint {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)
}

model Differential {
  id          String @id @default(cuid())
  title       String
  description String
  order       Int    @default(0)
}

model FeatureStripItem {
  id    String @id @default(cuid())
  title String
  image String
  order Int    @default(0)
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sector {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  icon        String   @default("leaf")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Formation {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  src       String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Rich full-detail blocks (Sondagem de Solo, Execução Ambiental, Topografia...).
// `groups` is [{ subtitle?: string, items: string[] }] stored as JSON since each
// block has a variable number of sub-groups with their own checklist items.
model SpecializedBlock {
  id        String   @id @default(cuid())
  title     String
  headline  String
  intro     String
  image     String
  order     Int      @default(0)
  groups    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pillar {
  id    String @id @default(cuid())
  title String
  icon  String @default("leaf")
  order Int    @default(0)
}

model HeroBadge {
  id     String @id @default(cuid())
  label  String
  value  String
  icon   String @default("check")
  order  Int    @default(0)
}

model WhyUsItem {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)
}

model ProcessStep {
  id          String @id @default(cuid())
  step        String
  title       String
  description String
  order       Int    @default(0)
}

model ClientGain {
  id    String @id @default(cuid())
  label String
  icon  String @default("check")
  order Int    @default(0)
}
